@router.callback_query(F.data == "adm_add:session")
async def start_add_session(callback: CallbackQuery, state: FSMContext):
    if is_owner(callback.from_user.id):
        await state.set_state(AddSessionProduct.waiting_for_info)
        await callback.message.answer(
            "📝 <b>Шаг 1 из 3:</b> Отправьте данные о товаре.\n\n"
            "Формат: <code>Подкатегория | Название | Цена Руб/Stars | Количество</code>\n"
            "<i>Пример: telegram | +1 США | 50/60 | 1</i>"
        )

@router.message(AddSessionProduct.waiting_for_info)
async def process_session_info(message: Message, state: FSMContext):
    if not is_owner(message.from_user.id):
        return

    parts = [p.strip() for p in message.text.split("|")]
    if len(parts) != 4:
        await message.answer("❌ Неверный формат. Нужно 4 параметра через `|`.")
        return

    prices = parse_prices(parts[2])
    if not prices:
        await message.answer("❌ Ошибка в цене. Формат: `50/60` или `50`.")
        return

    try:
        qty = int(parts[3])
    except ValueError:
        await message.answer("❌ Количество должно быть целым числом.")
        return

    await state.update_data(
        subcategory=parts[0], title=parts[1], price_rub=prices[0], price_stars=prices[1], qty=qty
    )
    await state.set_state(AddSessionProduct.waiting_for_file)
    await message.answer("📁 <b>Шаг 2 из 3:</b> Отправьте файл сессии Pyrogram (в формате <code>.session</code>).")

@router.message(AddSessionProduct.waiting_for_file, F.document)
async def process_session_file(message: Message, state: FSMContext):
    if not is_owner(message.from_user.id):
        return

    if not message.document.file_name.endswith(".session"):
        await message.answer("❌ Ошибка! Нужен файл с расширением <code>.session</code>.")
        return

    await state.update_data(session_file_id=message.document.file_id)
    await state.set_state(AddSessionProduct.waiting_for_phone)
    await message.answer("📱 <b>Шаг 3 из 3:</b> Отправьте номер телефона от аккаунта (например: <code>+1234567890</code>).")

@router.message(AddSessionProduct.waiting_for_file)
async def invalid_session_file(message: Message):
    await message.answer("❌ Пожалуйста, отправьте именно файл <code>.session</code> прикрепленным документом.")

@router.message(AddSessionProduct.waiting_for_phone)
async def process_session_phone(message: Message, state: FSMContext):
    if not is_owner(message.from_user.id):
        return

    phone = message.text.strip()
    data = await state.get_data()
    
    # Формат сохранения данных о типе сессии
    delivery_content = f"FILE:{data['session_file_id']}|PHONE:{phone}"

    try:
        with get_db() as conn:
            # Считываем текущее наполнение, если товар уже существовал, иначе сохраняем в новую запись
            cursor = conn.cursor()
            cursor.execute("SELECT item_content, available FROM products WHERE title = ? AND category = 'accounts'", (data['title'],))
            row = cursor.fetchone()

            if row:
                existing_content = row["item_content"] or ""
                new_content = (existing_content + "\n" + delivery_content).strip()
                new_avail = row["available"] + data['qty']
                cursor.execute("UPDATE products SET item_content = ?, available = ? WHERE title = ? AND category = 'accounts'",
                               (new_content, new_avail, data['title']))
            else:
                cursor.execute("""
                    INSERT INTO products (
                        category, subcategory, title, price_rub, price_stars, available, unit_amount, item_content
                    ) VALUES ('accounts', ?, ?, ?, ?, ?, 1, ?)
                """, (data['subcategory'], data['title'], data['price_rub'], data['price_stars'], data['qty'], delivery_content))

        await state.clear()
        await message.answer(f"✅ Аккаунт <b>{html.escape(data['title'])}</b> с прикрепленной сессией и номером успешно добавлен!")
    except Exception as e:
        await message.answer(f"❌ Произошла ошибка при сохранении: {e}")
        await state.clear()

