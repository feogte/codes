async def show_order_confirmation(message: Message, state: FSMContext):
    data = await state.get_data()

    qty = data["quantity"]
    orig_rub = data["price_rub"] * qty
    orig_stars = data["price_stars"] * qty
    discount = data.get("discount_percent", 0)

    final_rub = int(orig_rub * (1 - discount / 100))
    final_stars = int(orig_stars * (1 - discount / 100))

    await state.update_data(
        orig_rub=orig_rub,
        orig_stars=orig_stars,
        final_rub=final_rub,
        final_stars=final_stars,
    )

    pay_label = PAYMENT_METHOD_LABELS.get(data["payment_method"], data["payment_method"])
    total_price_str = money(final_rub) if data["payment_method"] == "card" else stars(final_stars)

    text = (
        "📋 <b>Подтверждение заказа</b>\n\n"
        f"📦 Товар: <b>{html.escape(data['product_title'])}</b>\n"
        f"Количество: <b>{qty} шт.</b>\n"
        f"💳 Способ оплаты: <b>{pay_label}</b>\n"
    )
    if discount > 0:
        text += f"🎟 Промокод: <b>{data['promo_code']}</b> (-{discount}%)\n"

    text += f"💰 Итого к оплате: <b>{total_price_str}</b>\n"

    if data.get("custom_details") != "—":
        text += f"🎯 Детали выдачи: <b>{html.escape(data['custom_details'])}</b>\n"

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [
            InlineKeyboardButton(text="✅ Подтвердить и перейти к оплате", callback_data="confirm_order"),
        ],
        [
            InlineKeyboardButton(text="❌ Отмена", callback_data="cancel_order"),
        ]
    ])

    await state.set_state(BuyFlow.confirmation)
    if message.from_user.is_bot:
        await safe_edit_text(message, text, reply_markup=kb)
    else:
        await message.answer(text, reply_markup=kb)


