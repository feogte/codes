def create_order(
    user_id: int,
    user_display: str,
    category: str,
    product_id: int | None,
    product_title: str,
    quantity: int,
    payment_method: str,
    orig_rub: int,
    orig_stars: int,
    final_rub: int,
    final_stars: int,
    promo_code: str | None,
    details: str,
    item_content: str = "",
) -> int:
    with get_db() as conn:
        cursor = conn.cursor()
        cursor.execute(
            """
            INSERT INTO orders (
                user_id, user_display, category, product_id, product_title,
                quantity, payment_method, original_price_rub, original_price_stars,
                final_price_rub, final_price_stars, promo_code, status, details, item_content, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?, ?)
            """,
            (
                user_id,
                user_display,
                category,
                product_id,
                product_title,
                quantity,
                payment_method,
                orig_rub,
                orig_stars,
                final_rub,
                final_stars,
                promo_code,
                details,
                item_content,
                utc_now_iso(),
            ),
        )
        order_id = cursor.lastrowid
        if promo_code:
            cursor.execute(
                "UPDATE promo_codes SET current_uses = current_uses + 1 WHERE code = ?",
                (promo_code,),
            )
        return order_id


