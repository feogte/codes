def is_owner(user_id: int) -> bool:
    return user_id == OWNER_ID

# ==============================================================================
# МИДДЛВАРЬ И ПРОВЕРКА ПОДПИСКИ
# ==============================================================================

async def is_subscribed(bot: Bot, user_id: int) -> bool:
    try:
        member = await bot.get_chat_member(REQUIRED_CHANNEL_ID, user_id)
        return member.status not in ("left", "kicked")
    except Exception:
        return False


class SubscriptionGateMiddleware(BaseMiddleware):
    def __init__(self, bot: Bot):
        super().__init__()
        self.bot = bot

    async def __call__(self, handler, event, data):
        user = getattr(event, "from_user", None)
        
        if user and is_owner(user.id):
            return await handler(event, data)

        callback_data = getattr(event, "data", None)
        if callback_data == "check_subscription":
            return await handler(event, data)

        if user and not await is_subscribed(self.bot, user.id):
            kb = InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="📢 Подписаться", url=REQUIRED_CHANNEL_URL)],
                [InlineKeyboardButton(text="✅ Проверить подписку", callback_data="check_subscription")]
            ])
            text_msg = "🔒 Для использования бота необходимо быть подписанным на канал."

            if isinstance(event, CallbackQuery):
                await event.answer()
                await event.message.answer(text_msg, reply_markup=kb)
            elif isinstance(event, Message):
                await event.answer(text_msg, reply_markup=kb)

            return

        return await handler(event, data)


