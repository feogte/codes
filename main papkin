def get_orders_page(page: int = 0, limit: int = 5) -> tuple[list[sqlite3.Row], int]:
    with get_db() as conn:
        total = conn.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
        orders = conn.execute(
            "SELECT * FROM orders ORDER BY id DESC LIMIT ? OFFSET ?",
            (limit, page * limit),
        ).fetchall()
        return orders, total


def get_statistics() -> dict[str, Any]:
    with get_db() as conn:
        start_utc, end_utc = today_utc_bounds()

        users_count = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]

        total_orders = conn.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
        approved_orders = conn.execute(
            "SELECT COUNT(*) FROM orders WHERE status = 'approved'"
        ).fetchone()[0]

        rev_rub = conn.execute(
            "SELECT SUM(final_price_rub) FROM orders WHERE status = 'approved'"
        ).fetchone()[0] or 0

        rev_stars = conn.execute(
            "SELECT SUM(final_price_stars) FROM orders WHERE status = 'approved'"
        ).fetchone()[0] or 0

        today_orders = conn.execute(
            "SELECT COUNT(*) FROM orders WHERE created_at >= ? AND created_at <= ?",
            (start_utc, end_utc),
        ).fetchone()[0]

        today_approved = conn.execute(
            """
            SELECT COUNT(*) FROM orders 
            WHERE status = 'approved' AND created_at >= ? AND created_at <= ?
            """,
            (start_utc, end_utc),
        ).fetchone()[0]

        today_rub = conn.execute(
            """
            SELECT SUM(final_price_rub) FROM orders 
            WHERE status = 'approved' AND created_at >= ? AND created_at <= ?
            """,
            (start_utc, end_utc),
        ).fetchone()[0] or 0

        today_stars = conn.execute(
            """
            SELECT SUM(final_price_stars) FROM orders 
            WHERE status = 'approved' AND created_at >= ? AND created_at <= ?
            """,
            (start_utc, end_utc),
        ).fetchone()[0] or 0

        return {
            "users_count": users_count,
            "total_orders": total_orders,
            "approved_orders": approved_orders,
            "revenue_rub": rev_rub,
            "revenue_stars": rev_stars,
            "today_orders": today_orders,
            "today_approved": today_approved,
            "today_revenue_rub": today_rub,
            "today_revenue_stars": today_stars,
        }


