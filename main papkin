        await message.answer("❌ Вы не отправили ни одной строки.")
        return

    data = await state.get_data()
    prod_id = data["edit_product_id"]
    product = get_product(prod_id)

    if product:
        current_content = (product["item_content"] or "").strip()
        updated_content = (current_content + "\n" + "\n".join(cleaned_items)).strip()
        new_stock = product["available"] + len(cleaned_items)

        with get_db() as conn:
            conn.execute(
                "UPDATE products SET item_content = ?, available = ? WHERE id = ?",
                (updated_content, new_stock, prod_id),
            )

        await state.clear()
        await message.answer(
            f"✅ Успешно добавлено строк: <b>{len(cleaned_items)}</b>.\n"
            f"📦 Новый остаток товара: <b>{new_stock} шт.</b>"
        )


