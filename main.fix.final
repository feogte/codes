        await state.set_state(AddPromo.waiting_for_info)
        await callback.message.answer(
            "📝 Отправьте данные промокода в формате:\n"
            "<code>КОД | СКИДКА_% | ЛИМИТ_ИСПОЛЬЗОВАНИЙ</code>\n\n"
            "<i>Пример: SALE2026 | 15 | 100</i>"
        )

@router.message(AddPromo.waiting_for_info)
async def process_add_promo(message: Message, state: FSMContext):
    if not is_owner(message.from_user.id):
        return

    parts = [p.strip() for p in message.text.split("|")]
    if len(parts) != 3:
        await message.answer("❌ Неверный формат! Нужно 3 значения через `|`.")
        return

    code = parts[0].upper()
    try:
        discount = int(parts[1])
        max_uses = int(parts[2])
    except ValueError:
        await message.answer("❌ Скидка и лимит должны быть целыми числами.")
        return

    if create_promo(code, discount, max_uses):
        await state.clear()
        await message.answer(f"✅ Промокод <b>{code}</b> со скидкой <b>{discount}%</b> создан!")
    else:
        await message.answer("❌ Промокод с таким названием уже существует.")
