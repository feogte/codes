@router.callback_query(F.data.startswith("adm_appr:"))
async def approve_order_callback(callback: CallbackQuery, bot: Bot):
    if not is_owner(callback.from_user.id):
        return

    order_id = int(callback.data.split(":")[1])
    order = get_order(order_id)

    if not order:
        await callback.answer("Заказ не найден!", show_alert=True)
        return

    if order["status"] == "approved":
        await callback.answer("Заказ уже подтвержден!", show_alert=True)
        return

    update_order_status(order_id, "approved")

    product = get_product(order["product_id"]) if order["product_id"] else None
    delivered_content = ""

    # Выдача цифрового товара (если это аккаунты из базы)
    if product and product["item_content"]:
        lines = [line.strip() for line in product["item_content"].strip().split("\n") if line.strip()]
        qty_needed = order["quantity"]

        if len(lines) >= qty_needed:
            issued_items = lines[:qty_needed]
            remaining_items = lines[qty_needed:]
            delivered_content = "\n".join(issued_items)

            new_content = "\n".join(remaining_items)
            new_stock = max(0, product["available"] - qty_needed)

            with get_db() as conn:
                conn.execute(
                    "UPDATE products SET item_content = ?, available = ? WHERE id = ?",
                    (new_content, new_stock, product["id"]),
                )
                conn.execute(
                    "UPDATE orders SET item_content = ? WHERE id = ?",
                    (delivered_content, order_id),
                )

    # Формируем уведомление для покупателя
    user_msg = f"🎉 <b>Ваш заказ #{order['id']} успешно подтвержден!</b>\n\n"
    user_msg += f"📦 Товар: <b>{html.escape(order['product_title'])}</b>\n"

    if delivered_content:
        user_msg += f"\n🔑 <b>Ваши данные для доступа:</b>\n<code>{delivered_content}</code>\n"
    else:
        user_msg += f"\nДетали / получатель: <b>{html.escape(order['details'])}</b>\n"
        user_msg += "Менеджер выполнит отправку услугу/звезды на указанные реквизиты в ближайшее время."

    user_msg += "\nСпасибо за покупку!"

    try:
        await bot.send_message(order["user_id"], user_msg)
        await callback.message.edit_text(callback.message.text + f"\n\n✅ <b>ЗАКАЗ #{order_id} ПОДТВЕРЖДЕН</b>")
    except Exception as e:
        logger.error(f"Ошибка при отправке уведомления пользователю {order['user_id']}: {e}")
        await callback.answer("Статус изменен, но не удалось отправить сообщение пользователю", show_alert=True)


