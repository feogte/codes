@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    save_user(message.from_user.id, message.from_user.username, message.from_user.first_name)
    show_admin = is_owner(message.from_user.id)
    text = (
        f"👋 Привет, <b>{html.escape(message.from_user.first_name)}</b>!\n\n"
        "Добро пожаловать в магазин аккаунтов и цифровых товаров."
    )
    await message.answer(text, reply_markup=main_menu_keyboard(show_admin))

@router.callback_query(F.data == "check_subscription")
async def check_sub_callback(callback: CallbackQuery, bot: Bot):
    if await is_subscribed(bot, callback.from_user.id):
        await callback.answer("✅ Подписка подтверждена!", show_alert=True)
        try:
            await callback.message.delete()
        except Exception:
            pass
        show_admin = is_owner(callback.from_user.id)
        await callback.message.answer("🎉 Спасибо за подписку!", reply_markup=main_menu_keyboard(show_admin))
    else:
        await callback.answer("❌ Вы всё ещё не подписаны на канал!", show_alert=True)

@router.message(F.text == "📝 Отзывы")
async def show_reviews(message: Message):
    kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="💬 Читать отзывы", url=REVIEWS_CHANNEL_URL)]])
    await message.answer("⭐ Отзывы наших клиентов доступны на канале:", reply_markup=kb)

@router.message(F.text == "👨‍💻 Поддержка")
async def show_support(message: Message):
    await message.answer(f"👨‍💻 <b>Служба поддержки</b>\n\nПо всем вопросам пишите: @{SUPPORT_USERNAME}")

@router.message(F.text.in_({"🛒 Купить аккаунты", "⭐ Купить Stars", "💎 Купить Premium"}))
async def start_category_flow(message: Message, state: FSMContext):
    await state.clear()
    cat_map = {"🛒 Купить аккаунты": "accounts", "⭐ Купить Stars": "stars", "💎 Купить Premium": "premium"}
    category = cat_map[message.text]
    products = get_products(category)

    if not products:
        await message.answer("😔 В данной категории пока нет доступных товаров.")
        return

    builder = InlineKeyboardBuilder()
    for prod in products:
        stock_str = stock_label(prod)
        btn_text = f"❌ {prod['title']} — Нет" if not product_can_buy(prod) else f"{prod['title']} | {product_prices(prod)} | {stock_str}"
        builder.button(text=btn_text, callback_data=f"buy_prod:{prod['id']}")

    builder.adjust(1)
    await message.answer(f"<b>{category_title(category)}</b>\n\nВыберите товар:", reply_markup=builder.as_markup())

@router.callback_query(F.data.startswith("buy_prod:"))
async def process_product_selection(callback: CallbackQuery, state: FSMContext):
    prod_id = int(callback.data.split(":")[1])
    product = get_product(prod_id)

    if not product or not product_can_buy(product):
        await callback.answer("❌ Товар не доступен!", show_alert=True)
        return

    await state.update_data(
        product_id=product["id"], category=product["category"], product_title=product["title"],
        price_rub=product["price_rub"], price_stars=product["price_stars"], unit_amount=product_unit_amount(product),
        available=product_available(product), item_content=product["item_content"] or ""
    )

    if product["category"] == "accounts":
        await state.set_state(BuyFlow.quantity)
        kb = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="1 шт", callback_data="qty:1"), InlineKeyboardButton(text="2 шт", callback_data="qty:2")]
        ])
        await callback.message.edit_text(
            f"🛒 Вы выбрали: <b>{html.escape(product['title'])}</b>\n"
            f"В наличии: <b>{product['available']} шт.</b>\nУкажите количество:",
            reply_markup=kb
        )
    else:
        await state.update_data(quantity=1)
        await show_payment_methods(callback.message, state)

@router.callback_query(F.data.startswith("qty:"))
async def process_qty_callback(callback: CallbackQuery, state: FSMContext):
    await process_quantity_input(int(callback.data.split(":")[1]), callback.message, state)

@router.message(BuyFlow.quantity)
async def process_qty_message(message: Message, state: FSMContext):
    qty = parse_quantity(message.text)
    if not qty or qty <= 0:
        await message.answer("❌ Введите корректное число.")
        return
    await process_quantity_input(qty, message, state)

async def process_quantity_input(qty: int, message: Message, state: FSMContext):
    data = await state.get_data()
    if qty > data["available"]:
        await message.answer(f"❌ Доступно только {data['available']} шт.")
        return
    await state.update_data(quantity=qty)
    await show_payment_methods(message, state)

async def show_payment_methods(message: Message, state: FSMContext):
    data = await state.get_data()
    price_rub = data["price_rub"] * data["quantity"]
    price_stars = data["price_stars"] * data["quantity"]

    builder = InlineKeyboardBuilder()
    if price_rub > 0:
        builder.button(text=f"💳 Рубли ({money(price_rub)})", callback_data="pay_method:card")
    if price_stars > 0:
        builder.button(text=f"⭐ Stars ({stars(price_stars)})", callback_data="pay_method:stars")
    builder.adjust(1)

    await state.set_state(BuyFlow.payment_method)
    text = f"📦 Товар: <b>{html.escape(data['product_title'])}</b> ({data['quantity']} шт.)\nВыберите способ оплаты:"
    
    if message.from_user.is_bot:
        await safe_edit_text(message, text, reply_markup=builder.as_markup())
    else:
        await message.answer(text, reply_markup=builder.as_markup())

@router.callback_query(F.data.startswith("pay_method:"))
async def process_payment_method(callback: CallbackQuery, state: FSMContext):
    await state.update_data(payment_method=callback.data.split(":")[1])
    
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🎟 Ввести промокод", callback_data="enter_promo")],
        [InlineKeyboardButton(text="➡️ Пропустить", callback_data="skip_promo")]
    ])
    await state.set_state(BuyFlow.promo_code)
    await callback.message.edit_text("🏷 Есть промокод на скидку?", reply_markup=kb)

@router.callback_query(F.data == "enter_promo", BuyFlow.promo_code)
async def ask_promo_code(callback: CallbackQuery):
    await callback.message.edit_text("🎟 Отправьте промокод в чат:")

@router.message(BuyFlow.promo_code)
async def process_promo_code(message: Message, state: FSMContext):
    code_text = message.text.strip().upper()
    promo = get_promo(code_text)

    if not promo:
        await message.answer("❌ Промокод не найден, неактивен или его лимит исчерпан. Введите еще раз или нажмите /cancel")
        return

    await state.update_data(promo_code=promo["code"], discount_percent=promo["discount_percent"])
    await message.answer(f"✅ Промокод <b>{promo['code']}</b> применен! Скидка: <b>{promo['discount_percent']}%</b>")
    await check_custom_details_needed(message, state)

@router.callback_query(F.data == "skip_promo", BuyFlow.promo_code)
async def skip_promo_code(callback: CallbackQuery, state: FSMContext):
    await state.update_data(promo_code=None, discount_percent=0)
    await check_custom_details_needed(callback.message, state)

async def check_custom_details_needed(message: Message, state: FSMContext):
    data = await state.get_data()
    if data["category"] in {"stars", "premium"}:
        await state.set_state(BuyFlow.custom_details)
        prompt = "Укажите ваш @username или ссылку куда отправлять:"
        await (message.edit_text(prompt) if message.from_user.is_bot else message.answer(prompt))
    else:
        await state.update_data(custom_details="—")
        await show_order_confirmation(message, state)

@router.message(BuyFlow.custom_details)
async def process_custom_details(message: Message, state: FSMContext):
    if not message.text.strip():
        await message.answer("❌ Укажите данные.")
        return
    await state.update_data(custom_details=message.text.strip())
    await show_order_confirmation(message, state)

async def show_order_confirmation(message: Message, state: FSMContext):
    data = await state.get_data()
    qty, discount = data["quantity"], data.get("discount_percent", 0)
    orig_rub, orig_stars = data["price_rub"] * qty, data["price_stars"] * qty
    final_rub = int(orig_rub * (1 - discount / 100))
    final_stars = int(orig_stars * (1 - discount / 100))

    await state.update_data(orig_rub=orig_rub, orig_stars=orig_stars, final_rub=final_rub, final_stars=final_stars)
    pay_label = PAYMENT_METHOD_LABELS.get(data["payment_method"], data["payment_method"])
    total_price = money(final_rub) if data["payment_method"] == "card" else stars(final_stars)

    text = (
        f"📋 <b>Подтверждение заказа</b>\n\n"
        f"📦 Товар: <b>{html.escape(data['product_title'])}</b> ({qty} шт.)\n"
        f"🎟 Промокод: <b>{data.get('promo_code') or 'Не использован'}</b> (Скидка {discount}%)\n"
        f"💳 Оплата: <b>{pay_label}</b>\n"
        f"💰 Итого: <b>{total_price}</b>\n"
    )
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Оплатить", callback_data="confirm_order")],
        [InlineKeyboardButton(text="❌ Отмена", callback_data="cancel_order")]
    ])
    await state.set_state(BuyFlow.confirmation)
    await (safe_edit_text(message, text, reply_markup=kb) if message.from_user.is_bot else message.answer(text, reply_markup=kb))

@router.callback_query(F.data == "confirm_order", BuyFlow.confirmation)
async def finalize_order(callback: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    user = callback.from_user
    order_id = create_order(
        user_id=user.id, user_display=safe_username(user.username, user.id), category=data["category"],
        product_id=data["product_id"], product_title=data["product_title"], quantity=data["quantity"],
        payment_method=data["payment_method"], orig_rub=data["orig_rub"], orig_stars=data["orig_stars"],
        final_rub=data["final_rub"], final_stars=data["final_stars"], promo_code=data.get("promo_code"),
        details=data.get("custom_details", "—"), item_content=data.get("item_content", "")
    )
    await state.clear()

    if data["payment_method"] == "card":
        req_text = f"🛒 <b>Заказ #{order_id} создан!</b>\nСумма: <b>{money(data['final_rub'])}</b>\nКарта: <code>{T_BANK_CARD_NUMBER}</code> ({T_BANK_NAME})"
    else:
        req_text = f"🛒 <b>Заказ #{order_id} создан!</b>\nСумма: <b>{stars(data['final_stars'])}</b>\nОтправьте Stars на: @{STARS_RECEIVER_USERNAME}"

    kb = InlineKeyboardMarkup(inline_keyboard=[[InlineKeyboardButton(text="✅ Я оплатил", callback_data=f"user_paid:{order_id}")]])
    await callback.message.edit_text(req_text, reply_markup=kb)

