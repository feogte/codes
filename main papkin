async def run_broadcast(callback: CallbackQuery, state: FSMContext, bot: Bot):
    if not is_owner(callback.from_user.id):
        return

    data = await state.get_data()
    text = data["broadcast_text"]
    await state.clear()

    user_ids = get_all_user_ids()
    await callback.message.edit_text(f"🚀 Начинаю рассылку на {len(user_ids)} пользователей...")

    success, fail = 0, 0
    for uid in user_ids:
        try:
            await bot.send_message(uid, text)
            success += 1
            await asyncio.sleep(0.05)
        except Exception:
            fail += 1

    await callback.message.answer(f"✅ Рассылка завершена!\n\nУспешно: <b>{success}</b>\nОшибок: <b>{fail}</b>")


