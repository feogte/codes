# ==============================================================================

async def listen_for_telegram_code(bot: Bot, user_id: int, phone: str, file_id: str):
    """Фоновый клиент Pyrogram для получения и отправки кода пользователю"""
    session_dir = Path("sessions")
    session_dir.mkdir(exist_ok=True)
    session_path = session_dir / f"{phone.replace('+', '')}"
    
    app = Client(
        str(session_path),
        api_id=API_ID,
        api_hash=API_HASH
    )

    code_received = asyncio.Event()

    async def code_handler(client, message):
        if message.from_user and message.from_user.id == 777000:
            match = re.search(r"\b(\d{5,6})\b", message.text)
            if match:
                code = match.group(1)
                await bot.send_message(user_id, f"ваш код: <code>{code}</code>")
                code_received.set()

    app.add_handler(MessageHandler(code_handler))

    try:
        await app.start()
        try:
            await asyncio.wait_for(code_received.wait(), timeout=600)
        except asyncio.TimeoutError:
            await bot.send_message(user_id, "⚠️ Время ожидания SMS-кода истекло.")
    except Exception as e:
        logger.error(f"Ошибка служебного Pyrogram для {phone}: {e}")
    finally:
        await app.stop()

@router.callback_query(F.data.startswith("adm_appr:"))
async def approve_order_callback(callback: CallbackQuery, bot: Bot):
    if not is_owner(callback.from_user.id):
        return

    order_id = int(callback.data.split(":")[1])
    order = get_order(order_id)

    if not order or order["status"] == "approved":
        await callback.answer("Заказ не найден или уже проверен!", show_alert=True)
        return

    update_order_status(order_id, "approved")
    await callback.message.edit_text(callback.message.text + "\n\n✅ <b>ПОДТВЕРЖДЕНО</b>")

    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="получить аккаунт", callback_data=f"get_acc:{order_id}")]
    ])
    
    try:
        await bot.send_message(
            chat_id=order["user_id"],
            text="Ваш аккаунт 👇🏻",
            reply_markup=kb
        )
    except Exception as e:
        logger.error(f"Ошибка отправки пользователю {order['user_id']}: {e}")

@router.callback_query(F.data.startswith("get_acc:"))
async def process_get_account(callback: CallbackQuery, bot: Bot):
    order_id = int(callback.data.split(":")[1])
    order = get_order(order_id)

    if not order:
        await callback.answer("Заказ не найден!", show_alert=True)
        return

    product = get_product(order["product_id"]) if order["product_id"] else None
    
    if not product or not product["item_content"]:
        await callback.answer("❌ Нет доступных аккаунтов на складе.", show_alert=True)
        return

    lines = [line.strip() for line in product["item_content"].split("\n") if line.strip()]
    if not lines:
        await callback.answer("❌ Аккаунты закончились.", show_alert=True)
        return

    acc_data = lines[0]
    remaining_lines = lines[1:]

    new_content = "\n".join(remaining_lines)
    with get_db() as conn:
        conn.execute(
            "UPDATE products SET item_content = ?, available = ? WHERE id = ?", 
            (new_content, len(remaining_lines), product["id"])
        )

    file_id, phone = "", ""
    if "FILE:" in acc_data and "|PHONE:" in acc_data:
        parts = acc_data.split("|PHONE:")
        file_id = parts[0].replace("FILE:", "").strip()
        phone = parts[1].strip()

    with get_db() as conn:
        conn.execute(
            "UPDATE orders SET session_file = ?, phone_number = ? WHERE id = ?", 
            (file_id, phone, order_id)
        )

    text = (
        f"📱 Ваш номер: <code>{phone}</code>\n\n"
        "как только придет код - мы отправим его вам"
    )
    await callback.message.edit_text(text)

    asyncio.create_task(listen_for_telegram_code(bot, order["user_id"], phone, file_id))

