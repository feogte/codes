def get_db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_db() -> None:
    with get_db() as conn:
        cursor = conn.cursor()
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                first_name TEXT,
                created_at TEXT NOT NULL
            )
            """
        )
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                category TEXT NOT NULL,
                subcategory TEXT NOT NULL,
                title TEXT NOT NULL,
                price_rub INTEGER NOT NULL,
                price_stars INTEGER NOT NULL,
                available INTEGER NOT NULL,
                unit_amount INTEGER NOT NULL DEFAULT 1,
                star_delivery_method TEXT DEFAULT 'standard',
                item_content TEXT DEFAULT ''
            )
            """
        )
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS promo_codes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                code TEXT UNIQUE NOT NULL,
                discount_percent INTEGER NOT NULL,
                max_uses INTEGER NOT NULL,
                current_uses INTEGER NOT NULL DEFAULT 0,
                is_active INTEGER NOT NULL DEFAULT 1,
                created_at TEXT NOT NULL
            )
            """
        )
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS orders (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                user_display TEXT NOT NULL,
                category TEXT NOT NULL,
                product_id INTEGER,
                product_title TEXT NOT NULL,
                quantity INTEGER NOT NULL,
                payment_method TEXT NOT NULL,
                original_price_rub INTEGER NOT NULL,
                original_price_stars INTEGER NOT NULL,
                final_price_rub INTEGER NOT NULL,
                final_price_stars INTEGER NOT NULL,
                promo_code TEXT,
                status TEXT NOT NULL,
                details TEXT NOT NULL,
                item_content TEXT DEFAULT '',
                created_at TEXT NOT NULL
            )
            """
        )

        # Миграция поля item_content, если БД уже создана
        cursor.execute("PRAGMA table_info(products)")
        columns = [row[1] for row in cursor.fetchall()]
        if "item_content" not in columns:
            cursor.execute("ALTER TABLE products ADD COLUMN item_content TEXT DEFAULT ''")

        cursor.execute("PRAGMA table_info(orders)")
        order_columns = [row[1] for row in cursor.fetchall()]
        if "item_content" not in order_columns:
            cursor.execute("ALTER TABLE orders ADD COLUMN item_content TEXT DEFAULT ''")

        # Начальное заполнение товарами
        cursor.execute("SELECT COUNT(*) AS count FROM products")
        if cursor.fetchone()["count"] == 0:
            for cat, sub, title, rub, star, stock, unit in SEED_PRODUCTS:
                cursor.execute(
                    """
                    INSERT INTO products (
                        category, subcategory, title, price_rub, price_stars, available, unit_amount, star_delivery_method, item_content
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, 'standard', '')
                    """,
                    (cat, sub, title, rub, star, stock, unit),
                )
        conn.commit()


