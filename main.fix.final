# ==============================================================================
# ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ==============================================================================

def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")

async def safe_edit_text(message: Message, text: str, reply_markup: InlineKeyboardMarkup | None = None) -> bool:
    try:
        await message.edit_text(text, reply_markup=reply_markup)
        return True
    except TelegramBadRequest as error:
        if "message is not modified" in str(error).lower():
            return False
        raise

def local_now() -> datetime:
    return datetime.now(TZ)

def today_utc_bounds() -> tuple[str, str]:
    current_date = local_now().date()
    start_local = datetime.combine(current_date, time.min, tzinfo=TZ)
    end_local = datetime.combine(current_date, time.max, tzinfo=TZ)
    return (
        start_local.astimezone(timezone.utc).isoformat(timespec="seconds"),
        end_local.astimezone(timezone.utc).isoformat(timespec="seconds"),
    )

def money(value: int) -> str:
    return f"{int(value):,}".replace(",", " ") + " ₽"

def stars(value: int) -> str:
    return f"{int(value):,}".replace(",", " ") + " ⭐"

def format_prices(price_rub: int, price_stars: int) -> str:
    parts: list[str] = []
    if price_rub > 0:
        parts.append(money(price_rub))
    if price_stars > 0:
        parts.append(stars(price_stars))
    return " / ".join(parts) if parts else "Бесплатно"

def product_prices(product: sqlite3.Row) -> str:
    return format_prices(int(product["price_rub"]), int(product["price_stars"]))

def order_amount(order: sqlite3.Row) -> str:
    if order["payment_method"] == "stars":
        return stars(int(order["final_price_stars"]))
    return money(int(order["final_price_rub"]))

def parse_prices(value: str) -> tuple[int, int] | None:
    normalized = value.strip().lower().replace("ё", "е")
    numbers = re.findall(r"\d+", normalized)
    if "/" in normalized:
        if len(numbers) != 2:
            return None
        return int(numbers[0]), int(numbers[1])
    if len(numbers) == 1:
        return int(numbers[0]), 0
    return None

def parse_quantity(value: str) -> int | None:
    match = re.fullmatch(r"\s*(\d+)\s*(?:шт\.?|штук[аи]?)?\s*", value.lower())
    return int(match.group(1)) if match else None

def product_unit_amount(product: sqlite3.Row) -> int:
    try:
        return max(1, int(product["unit_amount"]))
    except (IndexError, KeyError, TypeError, ValueError):
        return 1

def product_available(product: sqlite3.Row) -> int:
    return max(0, int(product["available"]))

def product_can_buy(product: sqlite3.Row) -> bool:
    return product_available(product) >= product_unit_amount(product)

def stock_label(product: sqlite3.Row) -> str:
    amount = product_available(product)
    if product["category"] == "stars":
        return stars(amount)
    return f"{amount} шт."

def safe_username(username: str | None, user_id: int) -> str:
    if username:
        return f"@{html.escape(username)}"
    return f"<code>{user_id}</code>"

def category_title(category: str) -> str:
    return CATEGORY_TITLES.get(category, f"📁 {html.escape(category)}")

def main_menu_keyboard(show_admin: bool = False) -> ReplyKeyboardMarkup:
    rows = [
        [KeyboardButton(text="🛒 Купить аккаунты"), KeyboardButton(text="⭐ Купить Stars")],
        [KeyboardButton(text="💎 Купить Premium")],
        [KeyboardButton(text="📝 Отзывы"), KeyboardButton(text="👨‍💻 Поддержка")],
    ]
    if show_admin:
        rows.append([KeyboardButton(text="⚙️ Админ-панель")])
    return ReplyKeyboardMarkup(keyboard=rows, resize_keyboard=True, input_field_placeholder="Выберите раздел")

# ==============================================================================
# БАЗА ДАННЫХ
# ==============================================================================

def get_db() -> sqlite3.Connection:
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db() -> None:
    with get_db() as conn:
        cursor = conn.cursor()

        cursor.execute("PRAGMA table_info(users)")
        user_columns = [row[1] for row in cursor.fetchall()]

        if user_columns and "id" not in user_columns:
            cursor.execute("DROP TABLE users")
            conn.commit()

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY,
                username TEXT,
                first_name TEXT,
                referrer_id INTEGER,
                created_at TEXT NOT NULL,
                last_seen_at TEXT
            )
        """)
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                category TEXT NOT NULL,
                subcategory TEXT NOT NULL,
                title TEXT NOT NULL,
                price_rub INTEGER NOT NULL,
                price_stars INTEGER NOT NULL,
                available INTEGER NOT NULL,
                unit_amount INTEGER NOT NULL DEFAULT 1,
                star_delivery_method TEXT DEFAULT 'standard',
                item_content TEXT DEFAULT ''
            )
        """)
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS promo_codes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                code TEXT UNIQUE NOT NULL,
                discount_percent INTEGER NOT NULL,
                max_uses INTEGER NOT NULL,
                current_uses INTEGER NOT NULL DEFAULT 0,
                is_active INTEGER NOT NULL DEFAULT 1,
                created_at TEXT NOT NULL
            )
        """)
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS orders (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                user_display TEXT NOT NULL,
                category TEXT NOT NULL,
                product_id INTEGER,
                product_title TEXT NOT NULL,
                quantity INTEGER NOT NULL,
                payment_method TEXT NOT NULL,
                original_price_rub INTEGER NOT NULL,
                original_price_stars INTEGER NOT NULL,
                final_price_rub INTEGER NOT NULL,
                final_price_stars INTEGER NOT NULL,
                promo_code TEXT,
                status TEXT NOT NULL,
                details TEXT NOT NULL,
                item_content TEXT DEFAULT '',
                session_file TEXT DEFAULT '',
                phone_number TEXT DEFAULT '',
                created_at TEXT NOT NULL
            )
        """)

        cursor.execute("PRAGMA table_info(products)")
        prod_cols = [row[1] for row in cursor.fetchall()]
        if "item_content" not in prod_cols:
            cursor.execute("ALTER TABLE products ADD COLUMN item_content TEXT DEFAULT ''")

        cursor.execute("PRAGMA table_info(orders)")
        ord_cols = [row[1] for row in cursor.fetchall()]
        if "item_content" not in ord_cols:
            cursor.execute("ALTER TABLE orders ADD COLUMN item_content TEXT DEFAULT ''")
        if "session_file" not in ord_cols:
            cursor.execute("ALTER TABLE orders ADD COLUMN session_file TEXT DEFAULT ''")
        if "phone_number" not in ord_cols:
            cursor.execute("ALTER TABLE orders ADD COLUMN phone_number TEXT DEFAULT ''")

        cursor.execute("SELECT COUNT(*) AS count FROM products")
        if cursor.fetchone()["count"] == 0:
            for cat, sub, title, rub, star, stock, unit in SEED_PRODUCTS:
                cursor.execute("""
                    INSERT INTO products (
                        category, subcategory, title, price_rub, price_stars, available, unit_amount, star_delivery_method, item_content
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, 'standard', '')
                """, (cat, sub, title, rub, star, stock, unit))
        conn.commit()

def save_user(user_id: int, username: str | None, first_name: str, referrer_id: int | None = None):
    with get_db() as conn:
        conn.execute("""
            INSERT INTO users (id, username, first_name, referrer_id, created_at, last_seen_at)
            VALUES (?, ?, ?, ?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(id) DO UPDATE SET
                username=excluded.username,
                first_name=excluded.first_name,
                last_seen_at=CURRENT_TIMESTAMP
        """, (user_id, username, first_name, referrer_id, utc_now_iso()))

def get_products(category: str) -> list[sqlite3.Row]:
    with get_db() as conn:
        return conn.execute("SELECT * FROM products WHERE category = ? ORDER BY id ASC", (category,)).fetchall()

def get_product(product_id: int) -> sqlite3.Row | None:
    with get_db() as conn:
        return conn.execute("SELECT * FROM products WHERE id = ?", (product_id,)).fetchone()

def delete_product(product_id: int) -> None:
    with get_db() as conn:
        conn.execute("DELETE FROM products WHERE id = ?", (product_id,))

def get_promo(code: str) -> sqlite3.Row | None:
    with get_db() as conn:
        return conn.execute(
            "SELECT * FROM promo_codes WHERE code = ? AND is_active = 1 AND current_uses < max_uses",
            (code.strip().upper(),)
        ).fetchone()

def create_promo(code: str, discount_percent: int, max_uses: int) -> bool:
    try:
        with get_db() as conn:
            conn.execute(
                "INSERT INTO promo_codes (code, discount_percent, max_uses, created_at) VALUES (?, ?, ?, ?)",
                (code.strip().upper(), discount_percent, max_uses, utc_now_iso())
            )
            return True
    except sqlite3.IntegrityError:
        return False

def get_all_promos() -> list[sqlite3.Row]:
    with get_db() as conn:
        return conn.execute("SELECT * FROM promo_codes WHERE is_active = 1 ORDER BY id DESC").fetchall()

def delete_promo(promo_id: int) -> None:
    with get_db() as conn:
        conn.execute("UPDATE promo_codes SET is_active = 0 WHERE id = ?", (promo_id,))

def create_order(user_id: int, user_display: str, category: str, product_id: int | None, product_title: str,
                 quantity: int, payment_method: str, orig_rub: int, orig_stars: int, final_rub: int,
                 final_stars: int, promo_code: str | None, details: str, item_content: str = "") -> int:
    with get_db() as conn:
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO orders (
                user_id, user_display, category, product_id, product_title,
                quantity, payment_method, original_price_rub, original_price_stars,
                final_price_rub, final_price_stars, promo_code, status, details, item_content, created_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?, ?, ?)
        """, (user_id, user_display, category, product_id, product_title, quantity, payment_method,
              orig_rub, orig_stars, final_rub, final_stars, promo_code, details, item_content or "", utc_now_iso()))
        order_id = cursor.lastrowid
        if promo_code:
            cursor.execute("UPDATE promo_codes SET current_uses = current_uses + 1 WHERE code = ?", (promo_code,))
        return order_id

def get_order(order_id: int) -> sqlite3.Row | None:
    with get_db() as conn:
        return conn.execute("SELECT * FROM orders WHERE id = ?", (order_id,)).fetchone()

def update_order_status(order_id: int, status: str) -> None:
    with get_db() as conn:
        conn.execute("UPDATE orders SET status = ? WHERE id = ?", (status, order_id))

def get_statistics() -> dict[str, Any]:
    with get_db() as conn:
        users_count = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]
        total_orders = conn.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
        approved_orders = conn.execute("SELECT COUNT(*) FROM orders WHERE status = 'approved'").fetchone()[0]
        rev_rub = conn.execute("SELECT SUM(final_price_rub) FROM orders WHERE status = 'approved'").fetchone()[0] or 0
        rev_stars = conn.execute("SELECT SUM(final_price_stars) FROM orders WHERE status = 'approved'").fetchone()[0] or 0

        return {
            "users_count": users_count, "total_orders": total_orders, "approved_orders": approved_orders,
            "revenue_rub": rev_rub, "revenue_stars": rev_stars
        }
# ==============================================================================
# FSM СОСТОЯНИЯ
# ==============================================================================

class BuyFlow(StatesGroup):
    category = State()
    product_id = State()
    quantity = State()
    payment_method = State()
    promo_code = State()
    custom_details = State()
    confirmation = State()

class AddSessionProduct(StatesGroup):
    waiting_for_info = State()
    waiting_for_file = State()
    waiting_for_phone = State()

class AddPromo(StatesGroup):
    waiting_for_info = State()

